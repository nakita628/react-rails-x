# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# 実行時にできるもの: ログ、一時ファイル、SQLite のデータベース、アップロード画像。
/log
/tmp
/storage

# Ignore master key for decrypting credentials and more.
/config/master.key

# node_modules（prisma + hekireki: モデル・ER 図・seed の生成用）。
/node_modules

# hekireki seed が書き込みに使う Prisma Client。`pnpm generate` が書き直す。
/generated/client
